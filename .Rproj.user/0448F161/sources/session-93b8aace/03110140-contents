# the objective of this pipeline is to generate the data required 
# for the regression models and their descriptives.

pacman::p_load(
  targets, 
  tidyverse, 
  pROC, 
  yardstick, 
  igraph, 
  tidygraph, 
  ggraph, 
  gt,
  sf,
  modelsummary
)

# Source network functions
tar_source(here::here("R", "DES", "data_des_prep.R"))

# Set pipeline options
