  controller = crew::crew_controller_local(workers = 10),
  garbage_collection = T, format = "qs",
  packages = c(
    "tidyverse",
    "targets",
    "modelsummary",
    "gt",
    "ggplot2",
    "sf",
    "patchwork"
  )
)


