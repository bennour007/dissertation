#' Calculate Local Moran's I
#'
#' @param data Regional panel data frame
#' @param var Variable name to test
#' @param year_filter Specific year to analyze
#' @param spatial_weights listw object from spdep
#' @return Data frame with local Moran's I statistics
calculate_local_morans <- function(data, var, year_filter, spatial_weights) {
  
  
  # Get the region order from spatial weights
  region_order <- attr(spatial_weights, "region_ids")
  
  # Filter to specific year
  data_year <- data %>%
    dplyr::filter(year == year_filter)
  
  # Create complete dataset matching spatial weights order
  # Fill missing regions with NA
  complete_data <- tibble::tibble(region = region_order) %>%
    dplyr::left_join(data_year, by = "region")
  
  # Check for missing regions
  n_missing <- sum(is.na(complete_data[[var]]))
  if (n_missing > 0) {
    warning("Year ", year_filter, " has ", n_missing, " regions with missing data for ", var)
  }
  
  # Extract variable vector in correct order
  var_vector <- complete_data[[var]]
  
  # Calculate local Moran's I (will handle NAs)
  local_moran <- spdep::localmoran(
    var_vector, 
    spatial_weights,
    na.action = na.exclude  # Handle missing values
  )
  
  # # Spatial lag for quadrant classification
  # wx <- lag.listw(spatial_weights, var_vector, zero.policy = TRUE, na.action = na.exclude)
  # 
  # # Mean-based classification
  # var_above_mean <- var_vector >= mean(var_vector, na.rm = TRUE)
  # lag_above_mean <- wx >= mean(wx, na.rm = TRUE)
  
  # Combine with original data
  result <- complete_data %>%
    dplyr::select(region, year, dplyr::all_of(var)) %>%
    dplyr::bind_cols(
      tibble::as_tibble(local_moran) %>%
        dplyr::rename(
          local_i = Ii,
          expectation = `E.Ii`,
          variance = `Var.Ii`,
          z_score = `Z.Ii`,
          p_value = `Pr(z != E(Ii))`
        )
    ) %>%
    dplyr::filter(!is.na(.data[[var]]))  # Remove regions with no data
  
  # Add cluster classification
  result <- result %>%
    dplyr::mutate(
      is_sig = if_else(p_value > 0.05, "Not significant", "significant"),
      # var_above_mean = var_above_mean,
      # lag_above_mean = lag_above_mean,
      cluster_type = dplyr::case_when(
        # p_value > 0.05 ~ "Not significant",
        # local_i > 0 & var_above_mean & lag_above_mean ~ "High-High",
        # local_i > 0 & !var_above_mean & !lag_above_mean ~ "Low-Low",
        # local_i < 0 & var_above_mean & !lag_above_mean ~ "High-Low",
        # local_i < 0 & !var_above_mean & lag_above_mean ~ "Low-High",
        local_i > 0 & .data[[var]] >= mean(.data[[var]], na.rm = TRUE) ~ "High-High",
        local_i > 0 & .data[[var]] < mean(.data[[var]], na.rm = TRUE) ~ "Low-Low",
        local_i < 0 & .data[[var]] >= mean(.data[[var]], na.rm = TRUE) ~ "High-Low",
        local_i < 0 & .data[[var]] < mean(.data[[var]], na.rm = TRUE) ~ "Low-High",
        TRUE ~ "check required"
      ),
      is_sig = factor(is_sig),
      cluster_type = factor(cluster_type)
    )
  
  return(result)
}


#' Create choropleth map for one or two years
#'
#' @param sf_data sf object with panel data and geometries
#' @param var Variable to map
#' @param year_filter Year to display
#' @param facet_0 Year 1 of the facet to display
#' @param facet_1 Year 2 of the facet to display
#' @param title Map title
#' @return ggplot map object
create_choropleth_map <- function(
    sf_data, var, 
    year_filter = NULL, 
    title = NULL, 
    facet_0 = NULL, 
    facet_1 = NULL
    ) {
  
  if (is.null(year_filter) && is.null(facet_0) && is.null(facet_1)){
    stop("Need either year_filter, or both facet_0, facet_1 to be non null numerics denoting years of filtering")
  }
  
  if (!is.null(year_filter) && (!is.null(facet_0) || !is.null(facet_1))){
    stop("Need EITHER year_filter, or BOTH facet_0, facet_1 to be non null numerics denoting years of filtering")
  }
  
  # Set default title
  if (is.null(title)) {
    title <- paste(var, "-", year_filter)
  }
  
  
  if (!is.null(year_filter) && is.null(facet_0) && is.null(facet_1)){
    # Filter to year
    map_data <- sf_data %>%
      dplyr::filter(year == year_filter)
    
    facets <- NULL
  }
  
  if (is.null(year_filter) && !is.null(facet_0) && !is.null(facet_1)){
    # Filter to year
    map_data <- sf_data %>%
      dplyr::filter(year %in% c(facet_0, facet_1))
    
    facets <- facet_grid(year ~ .)
  }
  
  
  # Create map
  p <- ggplot(map_data) +
    geom_sf(aes(fill = .data[[var]]), color = "white", linewidth = 0.2) +
    scale_fill_viridis_c(name = var, option = "plasma") +
    labs(title = title) + 
    coord_sf(xlim = c(-12, 45), ylim = c(34, 72), expand = FALSE) +
    # scale_x_continuous(limits = c(-10, 35)) +
    # scale_y_continuous(limits = c(35, 65)) +
    theme_void() + 
    facets
  
  return(p)
  
}


#' Create side-by-side comparison maps (2008 vs 2018)
#'
#' @param sf_data sf object with geometries
#' @param panel_data Regional panel data
#' @param var Variable to map
#' @return Combined ggplot object
create_comparison_maps <- function(sf_data, var) {
  
  # Create 2008 map
  map_2008 <- create_choropleth_map(sf_data, var, 2008, paste(var, "- 2008"))
  
  # Create 2018 map
  map_2018 <- create_choropleth_map(sf_data, var, 2018, paste(var, "- 2018"))
  
  # Combine using patchwork
  (map_2008 / map_2018) + 
    plot_layout(guides = "collect") +
    plot_annotation(title = paste("Comparison:", var))
}

