  if (is.null(year_filter) && !is.null(facet_0) && !is.null(facet_1)){
    # Filter to year
    map_data <- sf_data %>%
      dplyr::filter(year %in% c(facet_0, facet_1))
    
    facets <- facet_grid(. ~ year)
  }
  
  if (!is.null(local_moran_data_0)){
    map_data <- map_data %>%
      dplyr::left_join(local_moran_data_0, by = c("NUTS_ID" = "region", "year"))
  } 
  
  if(!is.null(local_moran_data_1)){
    map_data <- map_data %>%
      dplyr::left_join(local_moran_data_1, by = c("NUTS_ID" = "region", "year"))
  }
  
  
  # Define colors for cluster types
  cluster_colors <- c(
    "High-High" = "#d7191c",
    "Low-Low" = "#2b83ba",
    "High-Low" = "#fdae61",
    "Low-High" = "#abd9e9",
    "check required" = "#eeeeee"
  )

  
  sig_alphas <- c(
    "Not significant" = 0.3,
    "significant" = 1
  )
  
  # Create map
  map_data %>% 
    dplyr::mutate(
      is_sig = factor(is_sig)
    ) %>% 
  ggplot() +
    geom_sf(aes(fill = cluster_type, alpha = is_sig), color = "white", linewidth = 0.1) +
    scale_fill_manual(
      values = cluster_colors, 
      name = "Cluster Type", 
      breaks = c("High-High", "Low-Low", "High-Low", "Low-High")
    ) +
    scale_alpha_manual(values = sig_alphas) + 
    guides(alpha = "none") +  
    coord_sf(xlim = c(-12, 45), ylim = c(34, 72), expand = FALSE) +
    labs(title = paste("LISA Clusters -", unique(map_data$year))) +
    theme_void() + 
    theme(legend.position = "bottom", legend.direction = "horizontal") +
    facets
}